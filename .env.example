# Database Configuration (PostgreSQL)
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/decyra
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=decyra
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# LOCAL_DEV_MODE=true           # Set to true for development token support
# DEV_USER_ID=dev-user-00000000-0000-0000-0000-000000000000  # Optional: custom dev user ID

# Default for local development
DATABASE_TYPE=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decyra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=decyra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_JWT_SECRET=local-dev-jwt-secret-change-in-production
LOCAL_DEV_MODE=true
NODE_ENV=development

# Production Security Configuration
# POSTGRES_JWT_SECRET=your-secure-random-32-character-secret
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=your-secure-admin-password

