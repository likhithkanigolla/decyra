# ============================================================
# Decyra Docker Environment
# ============================================================

# Application
NODE_ENV=development
LOCAL_DEV_MODE=true

# Database type
DATABASE_TYPE=postgres
VITE_DATABASE_TYPE=postgres

# PostgreSQL service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=decyra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Application database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decyra

# JWT
POSTGRES_JWT_SECRET=local-dev-jwt-secret-change-in-production

# Development user
DEV_USER_ID=dev-user-00000000-0000-0000-0000-000000000000
